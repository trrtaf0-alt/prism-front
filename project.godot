; Godot Engine project configuration
config_version=5

[application]
config/name="Prism Front"
run/main_scene="res://scenes/Front.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/prism.svg"

[autoload]
Profile="*res://scripts/profile.gd"
Sound="*res://scripts/sound.gd"

[display]
window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/size/min_width=800
window/size/min_height=450

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.032, 0.048, 0.071, 1)
